<Project Sdk="Microsoft.NET.Sdk">
  <!-- Headless dumper. Compiles GMExplorer's Gm/ core by reference; nothing is copied into or changed in that repo. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>CattoDump</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <PlatformTarget>x64</PlatformTarget>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GmCore>C:\Users\monoc\source\repos\GMExplorer\GMExplorer\Gm\</GmCore>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="$(GmCore)GmData.cs" />
    <Compile Include="$(GmCore)Models.cs" />
    <Compile Include="$(GmCore)Reader.cs" />
    <Compile Include="$(GmCore)Bytecode.cs" />
    <Compile Include="$(GmCore)Decompiler.cs" />
    <Compile Include="$(GmCore)Textures.cs" />
    <Compile Include="$(GmCore)PeFile.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="SharpZipLib" Version="1.4.2" />
  </ItemGroup>
</Project>
